<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC">

    <!-- ========================================================= -->
    <!-- TOP BAR -->
    <!-- ========================================================= -->

    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#3877F1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clima Track"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Panel de control"
                android:textColor="#DCE8FF"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivMenuOpciones"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_menu_24"
            app:tint="#FFFFFF" />

    </LinearLayout>


    <!-- ========================================================= -->
    <!-- CONTENIDO -->
    <!-- ========================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topAppBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">


            <!-- ================================================= -->
            <!-- BIENVENIDA -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/icono"
                        android:contentDescription="Foto de perfil"
                        android:padding="3dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/icono" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSaludo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hola, Técnico"
                            android:textColor="#172033"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Bienvenido de nuevo"
                            android:textColor="#7B8494"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- RESUMEN -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Resumen de órdenes"
                android:textColor="#172033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Estado actual de tus órdenes de trabajo"
                android:textColor="#8A93A3"
                android:textSize="12sp" />


            <!-- TARJETAS DE ESTADO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="3">


                <!-- PENDIENTES -->

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#EDF4FF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountPendientes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#3877F1"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Pendientes"
                            android:textColor="#687386"
                            android:textSize="11sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- EN PROCESO -->

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#FFF5E8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountEnProceso"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#E69A27"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="En proceso"
                            android:textColor="#687386"
                            android:textSize="11sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


                <!-- FINALIZADAS -->

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="112dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="#ECF8F0"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCountFinalizadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#35A866"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Finalizadas"
                            android:textColor="#687386"
                            android:textSize="11sp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- ACCESOS RÁPIDOS -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Accesos rápidos"
                android:textColor="#172033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Gestiona rápidamente tu trabajo"
                android:textColor="#8A93A3"
                android:textSize="12sp" />


            <!-- FILA 1 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerOrdenes"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Órdenes"
                    android:textAllCaps="false"
                    android:textColor="#263248"
                    android:textSize="14sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:elevation="1dp"
                    app:icon="@drawable/ic_order"
                    app:iconGravity="top"
                    app:iconSize="32dp"
                    app:iconPadding="8dp"
                    app:iconTint="#3877F1"
                    app:strokeColor="#E7EBF2"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerEquipos"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Equipos"
                    android:textAllCaps="false"
                    android:textColor="#263248"
                    android:textSize="14sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:elevation="1dp"
                    app:iconSize="32dp"
                    app:icon="@drawable/ic_air"
                    app:iconGravity="top"
                    app:iconPadding="8dp"
                    app:iconTint="#35A866"
                    app:strokeColor="#E7EBF2"
                    app:strokeWidth="1dp" />

            </LinearLayout>


            <!-- FILA 2 -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGridHistorial"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Historial de Mantenimiento"
                    android:textAllCaps="false"
                    android:textColor="#263248"
                    android:textSize="14sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:elevation="1dp"
                    app:icon="@drawable/ic_history"
                    app:iconGravity="top"
                    app:iconPadding="8dp"
                    app:iconSize="32dp"
                    app:iconTint="#7957D5"
                    app:strokeColor="#E7EBF2"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesion"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Cerrar sesión"
                    android:textAllCaps="false"
                    android:textColor="#263248"
                    android:textSize="14sp"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:elevation="1dp"
                    app:icon="@drawable/ic_logout"
                    app:iconSize="32dp"
                    app:iconGravity="top"
                    app:iconPadding="8dp"
                    app:iconTint="#E05A5A"
                    app:strokeColor="#E7EBF2"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>