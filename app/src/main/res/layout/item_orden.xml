<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- 1. Círculo con Icono a la Izquierda -->
        <ImageView
            android:id="@+id/ivIconoOrden"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_circulo_azul"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_order"
            app:tint="@color/color_primary" />

        <!-- 2. Bloque Central: OT, Cliente y Equipo apilados -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Número de Orden -->
            <TextView
                android:id="@+id/tvNumeroOrden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OT-00025"
                android:textColor="@color/black"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Cliente -->
            <TextView
                android:id="@+id/tvCliente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Cliente: ACME S.A.S."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Equipo -->
            <TextView
                android:id="@+id/tvEquipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Equipo: Split Inverter 24K"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- TextView fantasma para conservar el ID de tipo de servicio sin romper lógica -->
            <TextView
                android:id="@+id/tvTipoServicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PREVENTIVO"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 3. Bloque Derecho: Fecha, Estado y Flecha -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <!-- Fecha -->
            <TextView
                android:id="@+id/tvFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18/08/2026"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Estado (Badge redondeado) -->
            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFF3E0"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Pendiente"
                android:textColor="@color/color_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Flecha indicadora a la extrema derecha -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/color_primary" />

    </LinearLayout>
</androidx.cardview.widget.CardView>